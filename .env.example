# Site configuration
NEXT_PUBLIC_SITE_URL=https://aivexanalytics.com

# Supabase (contact form persistence)
# From Supabase → Project Settings → API. Anon key is safe in the browser
# bundle as long as RLS is enabled — see supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics (optional) — set to 'plausible' or 'posthog'
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Plausible analytics (if using plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# PostHog analytics (if using posthog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
